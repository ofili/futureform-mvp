// }

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  firstName         String
  lastName          String
  jobTitle          String?
  department        String?
  role              UserRole  @default(USER)
  verified          Boolean   @default(false)
  emailVerified     Boolean   @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  passwordChangedAt DateTime?
  lastLoginAt       DateTime? // Track last login for active user metrics
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organizations           OrganizationMember[]
  projects                Project[]
  assessments             Assessment[]
  responses               AssessmentResponse[]
  tickets                 SupportTicket[]
  assignedTickets         SupportTicket[]              @relation("AssignedTickets")
  supportMessages         SupportTicketMessage[]
  // credits                 Credit[] // Moved to Organization
  creditTransactions      CreditTransaction[]
  comments                Comment[]
  activities              Activity[]
  documents               Document[]
  clarificationRequests   ClarificationRequest[]
  pdfExports              PdfExport[]
  teamMemberships         ProjectTeamMember[]          @relation("TeamMemberUser")
  teamInvitations         ProjectTeamMember[]          @relation("TeamMemberInviter")
  notifications           Notification[]
  sentInvitations         OrganizationInvitation[]     @relation("OrganizationInviter")
  auditLogs               AssessmentAuditLog[]
  notificationPreferences UserNotificationPreferences?
  notificationQueue       NotificationQueue[]
  onboardingProgress      UserOnboardingProgress?
  adminAuditLogs          AdminAuditLog[]

  // New relations for role-based assessment flow
  passwordResetTokens PasswordResetToken[]
  assessmentInvitations     AssessmentInvitation[] @relation("AssessmentRespondent")
  sentAssessmentInvitations AssessmentInvitation[] @relation("AssessmentInviter")
  uploadedEvidence          Evidence[]             @relation("EvidenceUploader")
  verifiedEvidence          Evidence[]             @relation("EvidenceVerifier")

  // Trust evidence relations
  uploadedTrustEvidence  TrustEvidenceFile[] @relation("EvidenceUploader")
  validatedTrustEvidence TrustEvidenceFile[] @relation("EvidenceValidator")
  
  // Currency exchange rate updates
  currencyRatesUpdated CurrencyExchangeRate[]

  // RC/EC Credit System relations
  rcTransactions           RespondentCreditTx[] @relation("RCRespondent")
  uploadedEnhancedEvidence EnhancedEvidence[]   @relation("EnhancedEvidenceUploader")
  verifiedEnhancedEvidence EnhancedEvidence[]   @relation("EnhancedEvidenceVerifier")

  // Payment transactions
  paymentTransactions PaymentTransaction[]

  @@map("users")
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  type                 String
  sectorFocus          String?
  region               String
  country              String?
  relationshipStage    String   @default("Discovery")
  source               String?
  referralSource       String?
  pilotAgreementSigned Boolean  @default(false)
  caseStudyApproval    Boolean  @default(false)
  description          String?
  website              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  members        OrganizationMember[]
  projects       Project[]
  credits        Credit[]
  invitations    OrganizationInvitation[]
  partnerAliases PartnerAlias[] // Partner registry for this org
  tierId         String?
  tier           SubscriptionTier?        @relation(fields: [tierId], references: [id])

  // RC/EC Credit System
  respondentCredits RespondentCredit[]
  evidenceCredits   EvidenceCredit[]

  // Payment transactions
  paymentTransactions PaymentTransaction[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())
  deletedAt      DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_members")
}

// ========================================
// PARTNER REGISTRY (Global + Org-Scoped)
// ========================================

enum PartnerVerification {
  UNVERIFIED
  SELF_VERIFIED
  FUTUREFORM_VERIFIED
}

// Global canonical partner record
model Partner {
  id             String              @id @default(cuid())
  legalName      String
  tradeName      String?
  website        String?
  country        String?
  headquarters   String?
  type           String? // Partner type from PARTNER_TYPE taxonomy
  sector         String?
  subsector      String?
  createdByOrgId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  verification   PartnerVerification @default(UNVERIFIED)
  metadata       Json?

  // CAC Verification fields
  cacNumber          String?   // CAC/RC registration number
  cacVerifiedName    String?   // Verified name from CAC
  cacVerifiedAt      DateTime? // When verification was performed
  cacVerificationData Json?    // Full CAC response data
  directors          Json?     // Array of company directors
  registeredAddress  String?   // Official registered address
  incorporationDate  DateTime? // Date of incorporation
  companyType        String?   // e.g., "Limited Liability", "PLC"
  rcNumber           String?   // RC number (same as CAC number typically)

  // Internal intelligence (not exposed to clients)
  aggregateScore Float? // Computed trust score across all assessments
  usageCount     Int    @default(0) // How many orgs use this partner

  // Relations
  aliases         PartnerAlias[]
  partnerContacts PartnerContact[]
  assessments     Assessment[]

  @@index([legalName])
  @@index([sector, country])
  @@index([cacNumber])
  @@index([rcNumber])
  @@map("partners")
}

// Organization-scoped view of a partner
model PartnerAlias {
  id                 String   @id @default(cuid())
  partnerId          String
  organizationId     String
  displayName        String
  internalNotes      String?
  relationshipStatus String? // "Active", "Past", "Blocked"
  visibility         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Cached fields for performance (denormalized from Partner)
  cachedWebsite String?
  cachedCountry String?
  cachedSector  String?

  partner      Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessments  Assessment[]

  @@unique([partnerId, organizationId])
  @@index([organizationId])
  @@map("partner_aliases")
}

// Partner contacts for invitations
model PartnerContact {
  id        String   @id @default(cuid())
  partnerId String
  name      String?
  email     String?
  phone     String?
  role      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("partner_contacts")
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Classification & Scope
  type      String // Dynamic classification via FormOption
  sector    String // e.g., "Pre-investment due diligence"
  subsector String? // [NEW]
  region    String
  country   String?
  orgSize   String? // [NEW]

  // Deployment Context [NEW]
  techCategory         String?
  techMaturity         String? // Distinct from maturityLevel if needed, or replace. Keeping both for now to avoid breaking existing.
  deploymentScope      String?
  deploymentComplexity String?
  successMetrics       String? // Text
  projectStage         String?
  maturityLevel        String? // e.g., "Nascent", "Developing", "Established" - Keep for backward compat if needed
  budgetRange          String? // e.g., "$50k–$150k"
  timeline             String? // e.g., "2025-06-30"

  // Strategic Intent
  objectives      String? // long-form field
  longDescription String? // [NEW]
  stakeholders    String? // JSON text or comma-separated list
  status          ProjectStatus @default(PLANNING)

  // Stakeholder & Governance Context [NEW]
  leadAgency               String?
  implementingPartners     String?
  vendors                  String?
  responsibleDepartments   String?
  projectSponsor           String?
  steeringCommittee        Boolean?
  interAgencyCollaboration String? // Low, Medium, High

  // Risk, Financial & Contractual [NEW]
  fundingSource          String?
  fundingPartners        String?
  contractType           String?
  contractDuration       String?
  vendorTrackRecord      String?
  knownRisks             String?
  regulatoryRequirements String?
  dataSensitivity        String?

  // Organizational Context [NEW]
  orgDigitalMaturity   String?
  operationalCapacity  String?
  workforceSize        String?
  changeReadiness      String?
  prevFailures         String?
  internalTrustClimate String?

  // Role & Question Mapping [NEW]
  departmentsInvolved   String[] @default([])
  expectedCollaborators String?
  keyFunctionalAreas    String[] @default([])
  seniorityMix          String[] @default([])
  orgStructure          String?

  // Ownership
  createdById    String
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  createdBy    User                @relation(fields: [createdById], references: [id])
  organization Organization?       @relation(fields: [organizationId], references: [id])
  assessments  Assessment[]
  comments     Comment[]
  activities   Activity[]
  documents    Document[]
  workflows    WorkflowRule[]
  events       CalendarEvent[]
  pdfExports   PdfExport[]
  teamMembers  ProjectTeamMember[]

  @@map("projects")
}

model Assessment {
  id        String @id @default(cuid())
  projectId String

  // OLD partner fields (kept for migration, will be deprecated)
  partnerId   String? // FK to User (partner admin) - nullable during migration
  partnerName String? // Nullable during migration
  partnerType String? // Nullable during migration

  // NEW partner fields (global + org-scoped)
  partnerGlobalId String? // FK to Partner (global canonical)
  partnerAliasId  String? // FK to PartnerAlias (org-scoped view)

  status          AssessmentStatus @default(PENDING)
  token           String           @unique
  invitedAt       DateTime         @default(now())
  completedAt     DateTime?
  overallScore    Int?
  confidenceLevel Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // New fields for role-based assessment flow
  type                 String? // "due_diligence", "procurement", etc.
  depth                String? // "quick", "standard", "deep"
  deadline             DateTime?
  aiConfig             Json? // AI selection parameters
  partnerAdminEmail    String? // Primary partner contact
  estimatedRespondents Int?
  estimatedDuration    Int? // in minutes

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partner             User?                @relation(fields: [partnerId], references: [id]) // OLD - nullable
  partnerGlobal       Partner?             @relation(fields: [partnerGlobalId], references: [id]) // NEW
  partnerAlias        PartnerAlias?        @relation(fields: [partnerAliasId], references: [id]) // NEW
  responses           AssessmentResponse[]
  drafts              AssessmentDraft[]
  scores              DomainScore[]
  redFlags            RedFlag[]
  pdfExports          PdfExport[]
  trustProfile        TrustProfile?
  decline             AssessmentDecline?
  facts               EvidenceFact[] // [NEW] Evidence facts for this assessment
  researchJobs        ResearchJob[]  // [NEW] Research jobs for this assessment
  auditLogs           AssessmentAuditLog[]
  creditTransactions  CreditTransaction[]
  declinedAssessments AssessmentDecline[]  @relation("ReinvitedAssessments")

  // New relations for role-based assessment flow
  assessmentQuestions AssessmentQuestion[]
  invitations         AssessmentInvitation[]

  // RC/EC Credit System relations
  rcTransactions RespondentCreditTx[]
  ecTransactions EvidenceCreditTx[]

  // Trust Intelligence Layer relations
  trustPartnerTypeId     String?
  trustPartnerType       TrustPartnerType?       @relation("TrustAssessmentPartnerType", fields: [trustPartnerTypeId], references: [id])
  trustDeploymentContext Json? // Sector, geography, stage, etc.
  trustRespondents       TrustRespondent[]       @relation("TrustAssessmentRespondents")
  trustResponses         TrustQuestionResponse[] @relation("TrustAssessmentResponses")
  trustEvidenceFiles     TrustEvidenceFile[]     @relation("TrustAssessmentEvidence")
  trustLayerScores       TrustLayerScore[]       @relation("TrustAssessmentLayerScores")
  trustScore             TrustScore?             @relation("TrustAssessmentScore")
  trustRedFlags          TrustRedFlag[]          @relation("TrustAssessmentRedFlags")

  // CoPilot AI-generated content
  coPilotDrafts          CoPilotDraft[]          @relation("AssessmentCoPilotDrafts")

  @@index([partnerGlobalId])
  @@index([partnerAliasId])
  @@index([trustPartnerTypeId])
  @@map("assessments")
}

model Question {
  id       String  @id @default(cuid())
  domain   String
  text     String
  helpText String?
  title    String?
  category String
  weight   Float   @default(1.0)
  order    Int

  // New fields for AI-driven question selection
  subDomain     String?
  sectorTags    String[] @default([]) // ["renewables", "finance", etc.]
  evidenceTypes Json     @default("[]") // Suggested evidence types
  baseScore     Float    @default(1.0)

  responses           AssessmentResponse[]
  drafts              AssessmentDraft[]
  assessmentQuestions AssessmentQuestion[]

  @@map("questions")
}

model AssessmentResponse {
  id               String    @id @default(cuid())
  assessmentId     String
  questionId       String
  userId           String
  response         String
  evidenceFiles    Json      @default("[]")
  evidence         String? // Deprecated, keep for migration safety if needed, or remove
  validated        Boolean   @default(false)
  validatedAt      DateTime?
  validationStatus String    @default("PENDING")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assessment              Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question                Question               @relation(fields: [questionId], references: [id])
  user                    User                   @relation(fields: [userId], references: [id])
  clarificationRequests   ClarificationRequest[]
  evidenceUploads         Evidence[] // Old evidence model
  enhancedEvidenceUploads EnhancedEvidence[] // New enhanced evidence model
  assessmentQuestion      AssessmentQuestion?    @relation(fields: [assessmentQuestionId], references: [id])
  assessmentQuestionId    String?

  @@unique([assessmentId, questionId])
  @@map("assessment_responses")
}

model AssessmentDraft {
  id           String   @id @default(cuid())
  assessmentId String
  questionId   String
  draftData    String
  isSubmitted  Boolean  @default(false)
  lastSaved    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id])

  @@unique([assessmentId, questionId])
  @@map("assessment_drafts")
}

model ClarificationRequest {
  id                   String    @id @default(cuid())
  assessmentResponseId String
  reviewerUserId       String
  clarificationMessage String
  responseDeadline     DateTime
  partnerResponse      String?
  partnerResponseFiles String[]  @default([])
  partnerRespondedAt   DateTime?
  reviewerDecision     String?
  reviewerNotes        String?
  decisionAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  assessmentResponse AssessmentResponse @relation(fields: [assessmentResponseId], references: [id], onDelete: Cascade)
  reviewer           User               @relation(fields: [reviewerUserId], references: [id])

  @@map("clarification_requests")
}

model PdfExport {
  id           String   @id @default(cuid())
  userId       String
  assessmentId String?
  projectId    String?
  type         String
  fileName     String
  fileUrl      String
  fileSize     Int
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user       User        @relation(fields: [userId], references: [id])
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("pdf_exports")
}

model ProjectTeamMember {
  id                   String    @id @default(cuid())
  projectId            String
  userId               String?
  invitedBy            String
  role                 String
  domainAccess         String[]  @default([])
  invitationToken      String    @unique
  invitationStatus     String    @default("PENDING")
  invitationSentAt     DateTime  @default(now())
  invitationAcceptedAt DateTime?
  removedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User?   @relation("TeamMemberUser", fields: [userId], references: [id])
  invitedByUser User    @relation("TeamMemberInviter", fields: [invitedBy], references: [id])

  @@map("project_team_members")
}

model FrameworkDownload {
  id           String   @id @default(cuid())
  email        String
  name         String
  organization String?
  sector       String?
  region       String?
  country      String?
  downloadedAt DateTime @default(now())

  @@map("framework_downloads")
}

// Marketing Leads (PQL - Product Qualified Leads)
model MarketingLead {
  id String @id @default(cuid())

  // Contact Information
  firstName    String
  lastName     String
  email        String
  organization String
  sector       String?
  country      String?

  // Lead Source & Tracking
  source        String // e.g., "framework_download", "contact_form", "webinar"
  downloadToken String?   @unique // Token for framework download
  tokenUsed     Boolean   @default(false)
  tokenUsedAt   DateTime?

  // Conversion Tracking
  converted   Boolean   @default(false) // Did they sign up?
  convertedAt DateTime?
  userId      String? // FK to User if they converted

  // Lead Status
  status    String @default("NEW") // NEW, CONTACTED, QUALIFIED, CONVERTED, LOST
  leadScore Int? // Optional lead scoring

  // HubSpot Integration
  hubspotSynced    Boolean   @default(false)
  hubspotContactId String? // HubSpot contact ID
  hubspotSyncedAt  DateTime?
  hubspotSyncError String? // Last sync error message

  // Metadata
  metadata Json? // Additional tracking data
  notes    String? // Internal notes

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([source])
  @@index([status])
  @@index([converted])
  @@index([hubspotSynced])
  @@map("marketing_leads")
}

model DomainScore {
  id           String   @id @default(cuid())
  assessmentId String
  domain       String
  score        Float
  confidence   Float
  createdAt    DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, domain])
  @@map("domain_scores")
}

model RedFlag {
  id           String   @id @default(cuid())
  assessmentId String
  type         String
  severity     String
  description  String
  createdAt    DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("red_flags")
}

model SupportTicket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique @default(cuid()) // Placeholder for generated ID
  userId       String
  category     TicketCategory
  subject      String
  description  String
  attachments  String[]       @default([])
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  assignedTo   String?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User                   @relation(fields: [userId], references: [id])
  assignedUser User?                  @relation("AssignedTickets", fields: [assignedTo], references: [id])
  messages     SupportTicketMessage[]

  @@map("support_tickets")
}

model SupportTicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  userId      String
  message     String
  isInternal  Boolean  @default(false)
  attachments String[] @default([])
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])

  @@map("support_ticket_messages")
}

enum TicketCategory {
  TECHNICAL
  BILLING
  ASSESSMENT_HELP
  ACCOUNT
  FEATURE_REQUEST
  OTHER
}

model Credit {
  id             String     @id @default(cuid())
  organizationId String
  amount         Int
  type           CreditType
  description    String?
  createdAt      DateTime   @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@map("credits")
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  content   String
  mentions  String[] @default([])
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@map("comments")
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  type      String
  data      Json
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@map("activities")
}

model Document {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  name      String
  type      String
  size      Int
  url       String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@map("documents")
}

model WorkflowRule {
  id        String   @id @default(cuid())
  projectId String
  name      String
  trigger   Json
  actions   Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("workflow_rules")
}

model CalendarEvent {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  type        String
  attendees   String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

enum UserRole {
  USER
  ADMIN
  PARTNER
}

enum OrganizationRole {
  OWNER
  ORG_ADMIN
  ADMIN
  MEMBER
  REVIEWER
  DOMAIN_EXPERT
  OBSERVER
  CREDIT_MANAGER
  PROJECT_ADMIN
}

enum ProjectType {
  PRE_INVESTMENT_DUE_DILIGENCE @map("Pre-investment due diligence")
  VENDOR_SELECTION_PROCUREMENT @map("Vendor selection / procurement")
  PORTFOLIO_MONITORING         @map("Portfolio monitoring (existing partners)")
  GOVERNANCE_AUDIT             @map("Governance audit")
  MULTI_STAKEHOLDER_ALIGNMENT  @map("Multi-stakeholder alignment")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AssessmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
  DRAFT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum DeclineReasonCategory {
  NOT_INTERESTED
  TIMELINE_ISSUE
  ALREADY_PARTNERED
  PROCESS_COMPLEX
  INFO_CONCERNS
  OTHER
}

enum NotificationFrequency {
  REALTIME
  DAILY
  WEEKLY
}

enum AuditAction {
  CREATED
  CANCELLED
  ARCHIVED
  RESTORED
  DELETED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CreditType {
  PURCHASE
  USAGE
  REFUND
  EXPIRE
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  actionUrl String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Organization Invitations
model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole @default(MEMBER)
  invitedBy      String
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  invitedAt      DateTime         @default(now())
  acceptedAt     DateTime?
  expiresAt      DateTime

  organization  Organization @relation(fields: [organizationId], references: [id])
  invitedByUser User         @relation("OrganizationInviter", fields: [invitedBy], references: [id])

  @@map("organization_invitations")
}

// Trust Profiles
model TrustProfile {
  id           String   @id @default(cuid())
  assessmentId String   @unique
  overallScore Int
  domainScores Json
  generatedAt  DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("trust_profiles")
}

// Assessment Declines
model AssessmentDecline {
  id                    String                @id @default(cuid())
  assessmentId          String                @unique
  declinedAt            DateTime              @default(now())
  declineReasonCategory DeclineReasonCategory
  declineReasonText     String?
  contactAttempted      Boolean               @default(false)
  contactAttemptedAt    DateTime?
  reInvited             Boolean               @default(false)
  reInvitedAt           DateTime?
  newAssessmentId       String?

  assessment    Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  newAssessment Assessment? @relation("ReinvitedAssessments", fields: [newAssessmentId], references: [id])

  @@map("assessment_declines")
}

// Assessment Audit Logs
model AssessmentAuditLog {
  id           String      @id @default(cuid())
  assessmentId String
  action       AuditAction
  performedBy  String
  reason       String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  performer  User       @relation(fields: [performedBy], references: [id])

  @@map("assessment_audit_log")
}

// Credit Transactions
model CreditTransaction {
  id            String     @id @default(cuid())
  creditId      String
  userId        String
  type          CreditType
  creditsChange Int
  assessmentId  String?
  notes         String?
  createdAt     DateTime   @default(now())

  credit     Credit      @relation(fields: [creditId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  assessment Assessment? @relation(fields: [assessmentId], references: [id])

  @@map("credit_transactions")
}

// User Notification Preferences
model UserNotificationPreferences {
  id     String @id @default(cuid())
  userId String @unique

  // Email preferences
  emailAssessmentSubmitted   Boolean @default(true)
  emailClarificationResponse Boolean @default(true)
  emailPartnerStarted        Boolean @default(false)
  emailTeamJoined            Boolean @default(true)
  emailTeamMention           Boolean @default(true)
  emailTeamActivity          Boolean @default(false)
  emailDeadlineReminder      Boolean @default(true)
  emailCreditLow             Boolean @default(true)
  emailCreditExpiring        Boolean @default(true)
  emailProfileGenerated      Boolean @default(true)
  emailExportReady           Boolean @default(true)
  emailPaymentSuccess        Boolean @default(true)
  emailPaymentFailed         Boolean @default(true)
  emailSecurityAlways        Boolean @default(true)

  // Frequency
  emailFrequency NotificationFrequency @default(REALTIME)
  digestTime     String?               @default("09:00:00")

  // In-app preferences
  inappEnabled     Boolean @default(true)
  inappSound       Boolean @default(true)
  inappDesktopPush Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("user_notification_preferences")
}

// Notification Queue
model NotificationQueue {
  id               String    @id @default(cuid())
  userId           String
  notificationType String
  notificationData Json
  sent             Boolean   @default(false)
  scheduledFor     DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_queue")
}

// User Onboarding Progress
model UserOnboardingProgress {
  id     String @id @default(cuid())
  userId String @unique

  // Tour completion
  tourStarted       Boolean @default(false)
  tourCompleted     Boolean @default(false)
  tourStepCompleted Int     @default(0)
  tourDismissed     Boolean @default(false)

  // Checklist items
  checklistCreditsPurchased Boolean @default(false)
  checklistProjectCreated   Boolean @default(false)
  checklistPartnerInvited   Boolean @default(false)
  checklistProfileGenerated Boolean @default(false)
  // Tooltips shown
  tooltipNewAssessmentShown Boolean @default(false)
  tooltipTrustScoreShown    Boolean @default(false)
  tooltipComparisonShown    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("user_onboarding_progress")
}

// Admin Audit Logs
model AdminAuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String?
  details    Json?
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// Pricing Tiers
model PricingTier {
  id        String   @id @default(cuid())
  currency  String
  credits   Int
  price     Int
  popular   Boolean  @default(false)
  savings   String?
  perCredit Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([currency, credits])
  @@index([currency])
  @@index([active])
  @@map("pricing_tiers")
}

model SubscriptionTier {
  id              String   @id @default(cuid())
  name            String   @unique
  displayName     String
  priceUSD        Decimal? @db.Decimal(10, 2)
  baseFeeUSD      Decimal? @db.Decimal(10, 2)
  type            String   @default("STANDARD") // 'FREE', 'GUIDED', 'ENTERPRISE'
  pricePeriod     String? // 'per assessment', 'annual', etc.
  creditsIncluded Int      @default(0)
  minRespondents  Int      @default(1)
  bestFor         String?
  description     String?
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizations       Organization[]
  features            TierFeature[]
  bands               CreditBand[]
  paymentTransactions PaymentTransaction[]
  creditPackages      CreditPricing[] // Back-relation for subscription packages
  packages            CreditPackage[] @relation("PackageTier") // SUBSCRIPTION packages linked to this tier

  @@map("subscription_tiers")
}

model TierFeature {
  id           String  @id @default(cuid())
  tierId       String
  feature      String
  description  String?
  displayOrder Int     @default(0)

  tier SubscriptionTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@map("tier_features")
}

model CreditBand {
  id           String  @id @default(cuid())
  tierId       String
  minCount     Int
  maxCount     Int? // Null means "and above"
  pricePerUnit Decimal @db.Decimal(10, 2)
  currency     String  @default("USD")

  tier SubscriptionTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@map("credit_bands")
}

model PlatformConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String // 'pricing', 'features', 'limits', etc.
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("platform_config")
}

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String
  status    String   @default("PENDING") // PENDING, CONTACTED, CLOSED
  createdAt DateTime @default(now())

  @@map("contact_requests")
}

model AdminQuestion {
  id           String   @id @default(cuid())
  category     String // 'governance', 'financial', etc.
  question     String
  description  String?
  displayOrder Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_questions")
}

model FormOption {
  id           String  @id @default(cuid())
  category     String // 'sector', 'region', 'department', etc.
  value        String
  label        String
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  parentId     String? // For hierarchical options (e.g., sub-categories)

  parent   FormOption?  @relation("FormOptionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children FormOption[] @relation("FormOptionHierarchy")

  @@unique([category, value])
  @@index([parentId])
  @@map("form_options")
}

model CreditPricing {
  id           String      @id @default(cuid())
  packageName  String
  type         PackageType @default(RC_ONLY) // Use enum instead of string
  
  // Credit amounts for different package types
  creditAmount Int?        // For RC_ONLY or EC_ONLY packages
  rcAmount     Int?        // For COMBINED packages - RC portion
  ecAmount     Int?        // For COMBINED packages - EC portion
  
  // Multi-currency pricing
  priceUSD     Decimal     @db.Decimal(10, 2)
  priceNGN     Decimal?    @db.Decimal(10, 2)
  priceGBP     Decimal?    @db.Decimal(10, 2)
  priceEUR     Decimal?    @db.Decimal(10, 2)
  
  // For SUBSCRIPTION type packages
  tierId       String?
  tier         SubscriptionTier? @relation(fields: [tierId], references: [id])
  
  isActive     Boolean     @default(true)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("credit_pricing")
}

// Currency exchange rates for multi-currency support
model CurrencyExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String   // e.g., "USD"
  toCurrency   String   // e.g., "NGN", "GBP", "EUR"
  rate         Decimal  @db.Decimal(10, 4)
  updatedBy    String   // Admin user ID
  updatedByUser User   @relation(fields: [updatedBy], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
  @@map("currency_exchange_rates")
}

// ============================================================================
// NEW MODELS FOR ROLE-BASED ASSESSMENT FLOW
// ============================================================================

model Role {
  id               String   @id @default(cuid())
  name             String   @unique // "Finance Manager", "HR Director", "CTO"
  description      String?
  typicalSeniority String? // "Senior", "Manager", "Director", "C-Level"
  domain           String? // Optional: link to FutureForm domain
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assessmentQuestions AssessmentQuestion[]
  invitations         AssessmentInvitation[]

  @@map("roles")
}

model AssessmentQuestion {
  id                   String   @id @default(cuid())
  assessmentId         String
  questionId           String
  assignedRoleId       String?
  assignedSeniority    String? // "Senior", "Manager", etc.
  evidenceRequirements Json     @default("[]") // Array of required evidence types
  order                Int
  aiConfidence         Float? // AI confidence score for this question
  aiRationale          String? // Why AI selected this question
  customized           Boolean  @default(false) // Owner edited AI suggestion
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  assessment Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question             @relation(fields: [questionId], references: [id])
  role       Role?                @relation(fields: [assignedRoleId], references: [id])
  responses  AssessmentResponse[]

  @@unique([assessmentId, questionId])
  @@map("assessment_questions")
}

model AssessmentInvitation {
  id           String           @id @default(cuid())
  assessmentId String
  email        String
  name         String?
  roleId       String?
  seniority    String?
  userId       String? // Set after user accepts
  token        String           @unique
  status       InvitationStatus @default(PENDING)
  invitedBy    String
  invitedAt    DateTime         @default(now())
  acceptedAt   DateTime?
  expiresAt    DateTime
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  role          Role?      @relation(fields: [roleId], references: [id])
  user          User?      @relation("AssessmentRespondent", fields: [userId], references: [id])
  invitedByUser User       @relation("AssessmentInviter", fields: [invitedBy], references: [id])

  @@map("assessment_invitations")
}

model Evidence {
  id                 String    @id @default(cuid())
  responseId         String
  fileName           String
  fileUrl            String
  fileType           String
  fileSize           Int
  uploadedBy         String
  uploadedAt         DateTime  @default(now())
  verifiedBy         String?
  verifiedAt         DateTime?
  verificationStatus String    @default("PENDING") // PENDING, APPROVED, REJECTED
  verificationNotes  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  response AssessmentResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  uploader User               @relation("EvidenceUploader", fields: [uploadedBy], references: [id])
  verifier User?              @relation("EvidenceVerifier", fields: [verifiedBy], references: [id])

  @@map("evidence")
}

model EvidenceFact {
  id              String   @id @default(cuid())
  assessmentId    String
  questionId      String?
  partnerId       String?
  
  // Core fact data
  factType        FactType
  source          FactSource
  sourceUrl       String?
  rawContent      String   @db.Text
  normalizedValue String?
  confidence      Float    @default(1.0)
  
  // Metadata
  collectedAt     DateTime @default(now())
  collectedBy     String?  // userId or "AGENT"
  validatedAt     DateTime?
  validatedBy     String?
  
  // Relations
  assessment      Assessment @relation(fields: [assessmentId], references: [id])
  
  @@map("evidence_facts")
}

enum FactType {
  RESPONSE        // From respondent answer
  DOCUMENT        // From uploaded document
  EXTERNAL_NEWS   // From news API
  EXTERNAL_REGISTRY // From company registry
  INTERNAL_NOTE   // From analyst
}

enum FactSource {
  RESPONDENT
  DOCUMENT_UPLOAD
  NEWS_API
  COMPANY_REGISTRY
  ANALYST_INPUT
  RESEARCH_AGENT
}

// Research Job Queue
model ResearchJob {
  id            String        @id @default(cuid())
  assessmentId  String
  partnerName   String
  rcNumber      String?       // Optional RC number for CAC lookup
  
  status        JobStatus     @default(PENDING)
  error         String?
  
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  assessment    Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  
  @@map("research_jobs")
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model SystemLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  level     String
  message   String
  metadata  Json?
  userId    String?
  action    String?

  @@index([timestamp])
  @@index([level])
  @@map("system_logs")
}

// ============================================================================
// RC/EC CREDIT SYSTEM
// ============================================================================

// Respondent Credits (RC) - For human intelligence collection
model RespondentCredit {
  id             String @id @default(cuid())
  organizationId String
  amount         Int    @default(0)

  // Credit tracking
  totalPurchased Int @default(0)
  totalUsed      Int @default(0)
  totalAvailable Int @default(0)

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions RespondentCreditTx[]

  @@unique([organizationId])
  @@map("respondent_credits")
}

model RespondentCreditTx {
  id       String   @id @default(cuid())
  creditId String
  type     RCTxType
  amount   Int
  balance  Int // Balance after transaction

  // Context
  assessmentId String?
  respondentId String? // User who consumed the credit
  packageId    String? // Which package was purchased
  notes        String?

  createdAt DateTime @default(now())

  credit     RespondentCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  assessment Assessment?      @relation(fields: [assessmentId], references: [id])
  respondent User?            @relation("RCRespondent", fields: [respondentId], references: [id])
  package    CreditPackage?   @relation("RCPackagePurchases", fields: [packageId], references: [id])

  @@index([creditId])
  @@index([assessmentId])
  @@index([type])
  @@map("respondent_credit_transactions")
}

enum RCTxType {
  PURCHASE
  USAGE
  REFUND
  EXPIRE
  ROLLOVER
}

// Evidence Credits (EC) - For machine/digital verification
model EvidenceCredit {
  id             String @id @default(cuid())
  organizationId String
  amount         Int    @default(0)

  // Credit tracking (using Decimal for fractional credits)
  totalPurchased Decimal @default(0) @db.Decimal(10, 2)
  totalUsed      Decimal @default(0) @db.Decimal(10, 2)
  totalAvailable Decimal @default(0) @db.Decimal(10, 2)

  // Auto-reload settings
  autoReloadEnabled   Boolean  @default(false)
  autoReloadThreshold Decimal? @db.Decimal(10, 2)
  autoReloadAmount    Decimal? @db.Decimal(10, 2)

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions EvidenceCreditTx[]

  @@unique([organizationId])
  @@map("evidence_credits")
}

model EvidenceCreditTx {
  id       String   @id @default(cuid())
  creditId String
  type     ECTxType
  amount   Decimal  @db.Decimal(10, 2)
  balance  Decimal  @db.Decimal(10, 2)

  // Evidence context
  evidenceType String? // "iot_sensor", "gps_trace", "llv_basic", etc.
  evidenceId   String? // Link to actual evidence record
  assessmentId String?
  packageId    String?
  notes        String?

  createdAt DateTime @default(now())

  credit     EvidenceCredit    @relation(fields: [creditId], references: [id], onDelete: Cascade)
  evidence   EnhancedEvidence? @relation("EvidenceECTransactions", fields: [evidenceId], references: [id])
  assessment Assessment?       @relation(fields: [assessmentId], references: [id])
  package    CreditPackage?    @relation("ECPackagePurchases", fields: [packageId], references: [id])

  @@index([creditId])
  @@index([evidenceType])
  @@index([type])
  @@map("evidence_credit_transactions")
}

enum ECTxType {
  PURCHASE
  USAGE
  REFUND
  EXPIRE
  ROLLOVER
  AUTO_RELOAD
}

// Credit Packages (RC, EC, or Combined)
model CreditPackage {
  id          String      @id @default(cuid())
  name        String      @unique
  displayName String
  type        PackageType

  // RC packages
  rcAmount Int?
  rcPrice  Decimal? @db.Decimal(10, 2)

  // EC packages
  ecAmount Decimal? @db.Decimal(10, 2)
  ecPrice  Decimal? @db.Decimal(10, 2)

  // Combined packages
  rcIncluded Int?
  ecIncluded Decimal? @db.Decimal(10, 2)
  totalPrice Decimal? @db.Decimal(10, 2)

  // Metadata
  description  String?
  features     String[] @default([])
  bestFor      String?
  popular      Boolean  @default(false)
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)

  // Subscription details (for recurring packages)
  billingPeriod String? // "monthly", "annual", null for one-time
  tierId        String? // Links SUBSCRIPTION packages to a tier
  tier          SubscriptionTier? @relation("PackageTier", fields: [tierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rcPurchases         RespondentCreditTx[] @relation("RCPackagePurchases")
  ecPurchases         EvidenceCreditTx[]   @relation("ECPackagePurchases")
  paymentTransactions PaymentTransaction[]

  @@map("credit_packages")
}

enum PackageType {
  RC_ONLY // Respondent Credits only
  EC_ONLY // Evidence Credits only
  COMBINED // Both RC and EC
  SUBSCRIPTION // Recurring subscription
}

// EC Pricing Table (transparent per-unit costs)
model ECPricing {
  id           String        @id @default(cuid())
  evidenceType String        @unique
  layer        EvidenceLayer
  costPerUnit  Decimal       @db.Decimal(10, 2)
  description  String?
  rationale    String?
  isActive     Boolean       @default(true)
  displayOrder Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([layer])
  @@index([isActive])
  @@map("ec_pricing")
}

// Enhanced Evidence Model (with layers and metadata)
model EnhancedEvidence {
  id         String  @id @default(cuid())
  responseId String? // Nullable for non-assessment evidence

  // Evidence classification
  layer    EvidenceLayer
  type     String // Specific type within layer
  category String? // Business category

  // File/Data
  fileName    String?
  fileUrl     String?
  fileType    String?
  fileSize    Int?
  dataPayload Json? // For DSE and structured data

  // Metadata (VE specific)
  metadata   Json? // Geolocation, device info, EXIF, etc.
  capturedAt DateTime?
  uploadedAt DateTime  @default(now())

  // Validation
  uploadedBy         String
  verifiedBy         String?
  verifiedAt         DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?

  // AI Analysis
  aiAnalysis   Json? // Anomaly scores, extracted entities, etc.
  aiConfidence Float?
  tamperFlags  Json?

  // Credit tracking
  ecCost Decimal? @db.Decimal(10, 2)

  // Relations
  response       AssessmentResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  uploader       User                @relation("EnhancedEvidenceUploader", fields: [uploadedBy], references: [id])
  verifier       User?               @relation("EnhancedEvidenceVerifier", fields: [verifiedBy], references: [id])
  ecTransactions EvidenceCreditTx[]  @relation("EvidenceECTransactions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([layer])
  @@index([type])
  @@index([verificationStatus])
  @@index([uploadedBy])
  @@map("enhanced_evidence")
}

enum EvidenceLayer {
  AE // Assessment Evidence
  VE // Verification Evidence
  DSE // Digital Signal Evidence
}

enum VerificationStatus {
  PENDING
  VALIDATED
  FLAGGED
  REJECTED
}

// ============================================================================
// TRUST INTELLIGENCE LAYER
// ============================================================================

// Trust Layers (L1-L6: Reliability, Transparency, Governance, Competence, Integrity, Ecosystem)
model TrustLayer {
  id             String   @id @default(cuid())
  layerId        String   @unique // "L1", "L2", "L3", "L4", "L5", "L6"
  name           String // "Reliability", "Transparency", etc.
  description    String?  @db.Text
  baselineWeight Float    @default(0.15)
  totalQuestions Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subDimensions TrustSubDimension[]
  layerScores   TrustLayerScore[]

  @@index([layerId])
  @@map("trust_layers")
}

// Sub-dimensions within each layer (e.g., "System Availability & Performance" within L1)
model TrustSubDimension {
  id          String     @id @default(cuid())
  dimensionId String     @unique // "1.1", "1.2", "2.1", etc.
  name        String
  weight      Float
  layerId     String
  layer       TrustLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions TrustQuestion[]

  @@index([layerId])
  @@map("trust_sub_dimensions")
}

// Individual trust questions from the ontology
model TrustQuestion {
  id               String              @id @default(cuid())
  questionId       String              @unique // "Q1.1.1", "Q1.1.2", etc.
  text             String              @db.Text
  subDimensionId   String
  subDimension     TrustSubDimension   @relation(fields: [subDimensionId], references: [id], onDelete: Cascade)
  stakeholderTypes String[] // ["Vendor", "Technical Team"]
  evidenceRequired String              @db.Text
  evidenceWeight   TrustEvidenceWeight // CRITICAL, HIGH, MEDIUM, LOW
  weightInLayer    Float
  scoringLogic     Json // Scoring criteria for 1-5
  redFlags         Json[] // Array of red flag conditions
  contextModifiers Json? // Context-specific adjustments
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  partnerTypes       TrustPartnerTypeQuestion[]
  responses          TrustQuestionResponse[]
  trustEvidenceFiles TrustEvidenceFile[]

  @@index([subDimensionId])
  @@index([questionId])
  @@map("trust_questions")
}

enum TrustEvidenceWeight {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

// Partner types (Technology Vendor, Implementation Partner, etc.)
model TrustPartnerType {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?  @db.Text
  layerWeights Json // Custom layer weights for this partner type
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requiredRoles TrustRequiredRole[]
  questions     TrustPartnerTypeQuestion[]
  assessments   Assessment[]               @relation("TrustAssessmentPartnerType")

  @@map("trust_partner_types")
}

// Required roles for each partner type
model TrustRequiredRole {
  id              String               @id @default(cuid())
  name            String
  layerCoverage   String[] // ["L1", "L4", "L5"]
  criticality     TrustRoleCriticality
  assessmentFocus String               @db.Text
  partnerTypeId   String
  partnerType     TrustPartnerType     @relation(fields: [partnerTypeId], references: [id], onDelete: Cascade)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  respondents TrustRespondent[]

  @@index([partnerTypeId])
  @@map("trust_required_roles")
}

enum TrustRoleCriticality {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

// Junction table: Partner types to questions mapping
model TrustPartnerTypeQuestion {
  id            String           @id @default(cuid())
  partnerTypeId String
  partnerType   TrustPartnerType @relation(fields: [partnerTypeId], references: [id], onDelete: Cascade)
  questionId    String
  question      TrustQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  isRequired    Boolean          @default(true)
  customWeight  Float? // Override default weight for this partner type

  @@unique([partnerTypeId, questionId])
  @@index([partnerTypeId])
  @@index([questionId])
  @@map("trust_partner_type_questions")
}

// Respondents for trust assessments
model TrustRespondent {
  id           String            @id @default(cuid())
  assessmentId String
  assessment   Assessment        @relation("TrustAssessmentRespondents", fields: [assessmentId], references: [id], onDelete: Cascade)
  name         String
  email        String
  roleId       String
  role         TrustRequiredRole @relation(fields: [roleId], references: [id])
  invitedAt    DateTime          @default(now())
  completedAt  DateTime?
  accessToken  String            @unique @default(cuid())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  responses TrustQuestionResponse[]

  @@index([assessmentId])
  @@index([accessToken])
  @@index([email])
  @@map("trust_respondents")
}

// Responses to trust questions
model TrustQuestionResponse {
  id           String          @id @default(cuid())
  assessmentId String
  assessment   Assessment      @relation("TrustAssessmentResponses", fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     TrustQuestion   @relation(fields: [questionId], references: [id])
  respondentId String
  respondent   TrustRespondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  textResponse String?         @db.Text
  submittedAt  DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  evidenceFiles TrustEvidenceFile[]

  @@index([assessmentId])
  @@index([questionId])
  @@index([respondentId])
  @@map("trust_question_responses")
}

// Evidence files uploaded for trust assessments
model TrustEvidenceFile {
  id           String                 @id @default(cuid())
  assessmentId String
  assessment   Assessment             @relation("TrustAssessmentEvidence", fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String?
  question     TrustQuestion?         @relation(fields: [questionId], references: [id])
  responseId   String?
  response     TrustQuestionResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)

  // File Information
  fileName String
  fileType String // MIME type
  fileSize Int // bytes

  // Storage (Vercel Blob)
  storageUrl String // Public URL from Vercel Blob
  storageKey String // Blob storage key for deletion

  // Upload Metadata
  uploadedById String
  uploadedBy   User     @relation("EvidenceUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  // Validation
  validationStatus TrustEvidenceValidation @default(PENDING)
  validatedById    String?
  validatedBy      User?                   @relation("EvidenceValidator", fields: [validatedById], references: [id])
  validatedAt      DateTime?
  validationNotes  String?                 @db.Text

  // Processing
  processingStatus TrustProcessingStatus @default(PENDING)
  documentType     String? // Classified type: financial_statement, contract, etc.
  extractedText    String?               @db.Text
  extractedData    Json? // Structured data extracted from document
  qualityScore     Float? // 1-5 quality score
  processingError  String?               @db.Text

  @@index([assessmentId])
  @@index([questionId])
  @@index([responseId])
  @@index([uploadedById])
  @@map("trust_evidence_files")
}

enum TrustProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TrustEvidenceValidation {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

// Layer scores for each assessment
model TrustLayerScore {
  id                 String     @id @default(cuid())
  assessmentId       String
  assessment         Assessment @relation("TrustAssessmentLayerScores", fields: [assessmentId], references: [id], onDelete: Cascade)
  layerId            String
  layer              TrustLayer @relation(fields: [layerId], references: [id])
  score              Float // 1.0 - 5.0
  confidence         Float // 0.0 - 1.0
  evidenceQuality    Float // Average quality of evidence for this layer
  subDimensionScores Json // Breakdown by sub-dimension
  calculatedAt       DateTime   @default(now())

  @@unique([assessmentId, layerId])
  @@index([assessmentId])
  @@index([layerId])
  @@map("trust_layer_scores")
}

// Overall trust score for an assessment
model TrustScore {
  id                 String              @id @default(cuid())
  assessmentId       String              @unique
  assessment         Assessment          @relation("TrustAssessmentScore", fields: [assessmentId], references: [id], onDelete: Cascade)
  overallScore       Float // 1.0 - 5.0
  confidence         Float // 0.0 - 1.0
  confidenceInterval Float // ± value
  recommendation     TrustRecommendation
  calculatedAt       DateTime            @default(now())
  approvedAt         DateTime?
  approvedBy         String?

  // Narrative sections (generated by LLM)
  executiveSummary    String? @db.Text
  strengthsNarrative  String? @db.Text
  weaknessesNarrative String? @db.Text
  recommendationsText String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trust_scores")
}

enum TrustRecommendation {
  PROCEED_CONFIDENTLY
  PROCEED_WITH_CAUTION
  REQUIRE_REMEDIATION
  DO_NOT_PROCEED
}

// Red flags detected during assessment
model TrustRedFlag {
  id           String            @id @default(cuid())
  assessmentId String
  assessment   Assessment        @relation("TrustAssessmentRedFlags", fields: [assessmentId], references: [id], onDelete: Cascade)
  severity     TrustFlagSeverity
  category     String // "Financial", "Technical", "Integrity", etc.
  condition    String // The condition that triggered the flag
  message      String            @db.Text
  layerId      String?
  questionId   String?
  detectedAt   DateTime          @default(now())

  @@index([assessmentId])
  @@index([severity])
  @@map("trust_red_flags")
}

enum TrustFlagSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

// Sector-specific layer weights
model TrustSectorWeight {
  id           String   @id @default(cuid())
  sector       String   @unique
  layerWeights Json // Custom weights for each layer
  rationale    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("trust_sector_weights")
}

// Veto criteria that can override scores
model TrustVetoCriterion {
  id                   String            @id @default(cuid())
  vetoId               String            @unique // "L1_Veto_Availability", etc.
  name                 String
  description          String?           @db.Text // Rationale
  condition            String?           @db.Text // Logical condition (legacy)
  layer                String            @default("L1") // L1, L2, L3, etc.
  subDimension         String? // Sub-dimension name
  thresholdValue       Float? // Numeric threshold (e.g., 2.0)
  thresholdDescription String? // Human-readable threshold
  action               String            @default("DO NOT PROCEED") // Action to take
  severity             TrustFlagSeverity @default(CRITICAL)
  message              String?           @db.Text
  overridesScore       Boolean           @default(true)
  sector               String? // Null = applies to all sectors
  partnerType          String? // Null = applies to all partner types
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([vetoId])
  @@index([isActive])
  @@index([layer])
  @@index([sector])
  @@map("trust_veto_criteria")
}


// ============================================================================
// PAYMENT SYSTEM
// ============================================================================

// Payment transactions for Flutterwave integration
model PaymentTransaction {
  id               String        @id @default(cuid())
  organizationId   String
  userId           String
  type             PaymentType
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("NGN")
  status           PaymentStatus
  provider         String        @default("flutterwave")
  transactionRef   String        @unique
  flutterwaveTxId  Int?
  flutterwaveTxRef String?
  metadata         Json?
  tierId           String?
  packageId        String?
  paymentLink      String?
  redirectUrl      String?
  webhookReceived  Boolean       @default(false)
  verifiedAt       DateTime?
  completedAt      DateTime?
  failureReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  tier         SubscriptionTier? @relation(fields: [tierId], references: [id])
  package      CreditPackage?    @relation(fields: [packageId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([transactionRef])
  @@index([status])
  @@index([createdAt])
  @@map("payment_transactions")
}

enum PaymentType {
  TIER_UPGRADE
  RC_PURCHASE
  EC_PURCHASE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

// ==========================================
// AI CoPilot Models
// ==========================================

model CoPilotDraft {
  id           String   @id @default(cuid())
  assessmentId String
  type         String   // 'summary', 'report', 'risk_analysis'
  content      Json     // Structured output (Summary, DraftReport, or RiskAssessment)
  confidence   Float    @default(0)
  tokensUsed   Int      @default(0)
  generatedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment   Assessment @relation("AssessmentCoPilotDrafts", fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([type])

  @@map("copilot_drafts")
}




model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@map("password_reset_tokens")
}
