# Test Environment Variables

# Database
DATABASE_URL="postgresql://test:test@localhost:5432/futureform_test"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="test-secret-key-for-testing-purposes-only"

# Email (use test/sandbox credentials)
MAILGUN_API_KEY="test-mailgun-key"
MAILGUN_DOMAIN="sandbox.mailgun.org"
MAILGUN_FROM_EMAIL="test@sandbox.mailgun.org"

# Payment (use test keys)
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxx"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxx"
FLUTTERWAVE_ENCRYPTION_KEY="FLWSECK_TESTxxxxx"

# HubSpot (disabled in tests)
HUBSPOT_ACCESS_TOKEN="test-hubspot-token"
HUBSPOT_ENABLED="false"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="test"
