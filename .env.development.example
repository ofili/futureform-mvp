# ============================================
# FUTUREFORM DEVELOPMENT ENVIRONMENT
# Local PostgreSQL Configuration
# ============================================
# 
# This file is a template for local development.
# Copy this to .env.local and update with your actual values.
# 
# IMPORTANT: .env.local is gitignored and should NEVER be committed
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Local PostgreSQL Database
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:password@localhost:5432/futureform_dev"

# Alternative: Using Docker PostgreSQL
# DATABASE_URL="postgresql://postgres:docker@localhost:5432/futureform_dev"

# ============================================
# NEXTAUTH CONFIGURATION
# ============================================

# NextAuth URL (local development)
NEXTAUTH_URL="http://localhost:3000"

# NextAuth Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-development-secret-key-replace-this"

# ============================================
# EMAIL CONFIGURATION (Development)
# ============================================

# Mailgun Configuration (optional for dev)
MAILGUN_API_KEY="your-mailgun-api-key"
MAILGUN_DOMAIN="your-mailgun-domain"
MAILGUN_FROM_EMAIL="noreply@yourdomain.com"

# Alternative: Use a test email service like Mailtrap
# SMTP_HOST="smtp.mailtrap.io"
# SMTP_PORT="2525"
# SMTP_USER="your-mailtrap-user"
# SMTP_PASS="your-mailtrap-password"

# ============================================
# FILE STORAGE (Development)
# ============================================

# AWS S3 Configuration (optional for dev, can use local storage)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="futureform-dev-files"

# Alternative: Use local file storage for development
# FILE_STORAGE_TYPE="local"
# FILE_STORAGE_PATH="./uploads"

# ============================================
# EXTERNAL SERVICES (Development)
# ============================================

# Sentry (optional for dev)
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Vercel Speed Insights (optional for dev)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Environment
NODE_ENV="development"

# API Base URL
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# ============================================
# FEATURE FLAGS (Development)
# ============================================

# Enable debug logging
DEBUG="true"

# Enable Prisma Studio
PRISMA_STUDIO_ENABLED="true"

# ============================================
# NOTES FOR DEVELOPERS
# ============================================
#
# 1. SETUP LOCAL DATABASE:
#    - Install PostgreSQL locally OR use Docker
#    - Create database: createdb futureform_dev
#    - Run migrations: npm run db:migrate
#    - Seed database: npm run db:seed
#
# 2. GENERATE NEXTAUTH_SECRET:
#    - Run: openssl rand -base64 32
#    - Or use: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# 3. SWITCHING TO SUPABASE (main branch):
#    - Use .env.production or update .env.local
#    - Change DATABASE_URL to Supabase connection string
#
# 4. DOCKER POSTGRESQL SETUP:
#    docker run --name futureform-postgres \
#      -e POSTGRES_PASSWORD=docker \
#      -e POSTGRES_DB=futureform_dev \
#      -p 5432:5432 \
#      -d postgres:15
#
# ============================================
